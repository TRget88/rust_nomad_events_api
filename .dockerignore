# Rust build artifacts — bloats the build context and the planner stage
# would invalidate cache on every local `cargo build`.
target/
**/target/

# Local secrets and dev DBs that should never enter the image.
.env
.env.*
events.db
events.db-journal
event.db
event.db-journal
*.sqlite
*.sqlite-journal
*.sqlite3
sqlite3.exe

# VCS and editor cruft.
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store

# Repo-meta files that don't affect the build. Excluding them keeps the
# build context small without breaking anything.
README.md
LICENSE
*.md
deploymentReadMe.txt
DockerInfo.txt
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml

# Curator service lives in a sibling repo — defensive in case anyone
# bind-mounts the parent dir during local Docker experiments.
festurah_event_curator/
