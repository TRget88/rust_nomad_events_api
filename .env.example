# Copy to .env and fill in real values. The .env file should NOT be committed
# (see /.gitignore — currently only blocks /.env, not env files in subdirs).
# All values are required unless marked optional.

# Listening port for the HTTP server. Defaults to 3000 in code if unset.
PORT=3000

# HMAC secret used to sign and verify JWTs. Generate with e.g.
#   openssl rand -hex 64
# Rotate this and every active session is invalidated.
JWT_SECRET=changeme

# SHA-256 hex digest of the expected X-API-Key header value. Compute with:
#   echo -n "your-api-key-here" | sha256sum
# Public auth routes (/auth/google/signup, /auth/google/login) require the
# matching raw key in the X-API-Key header.
API_KEY_HASH=changeme

# OAuth client ID issued by Google Cloud Console for the frontend's
# @react-oauth/google flow. The backend verifies that incoming ID tokens
# have this client ID as the `aud` claim.
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

# Optional: set SEED=1 once at deploy time to populate the database with
# fixture event types / camping profiles / events. seed_all is idempotent
# (no-op if event_types is already populated), so this is safe to leave set.
# SEED=1
